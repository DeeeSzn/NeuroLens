# Read from backend/.env; never commit your populated .env.
NEUROLENS_TRIBE_DEVICE=mps
NEUROLENS_TRIBE_VIDEO_BATCH_SIZE=1
NEUROLENS_TRIBE_EXTRACTOR_DTYPE=float16
NEUROLENS_MEM_GUARD_ENABLED=true
NEUROLENS_MEM_MAX_SWAP_GB=6.0
NEUROLENS_UPLOAD_DIR=./uploads
NEUROLENS_RESULTS_DIR=./results
NEUROLENS_INSIGHT_REFERENCES_DIR=./references
NEUROLENS_DATABASE_URL=sqlite+aiosqlite:///./neurolens.db
# Authenticate with `hf auth login` locally. Do not put a token in source.
